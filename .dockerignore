# node_modules is reinstalled inside the image: the host's copy holds a native
# LaserStream binding built for the host's platform, not the container's.
node_modules
.next

.git
# Secrets never go into an image; containers get them from env_file at run time.
.env*
!.env.example
*.pem
*.key
# Local scratch and tooling: nothing the app runs.
ag-test.js
.claude
tests
coverage
backups
*.tsbuildinfo
npm-debug.log*
